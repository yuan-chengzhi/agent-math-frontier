{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuan-chengzhi/agent-math-frontier/schemas/receipts.v2.schema.json",
  "title": "AMF provider-accounting budget receipt version 2",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "problemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "budgetReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "problem_id", "target_card_sha256", "limits", "maximum_artifact_bytes", "retain_failures", "stop_conditions", "checked_at"],
      "properties": {
        "schema": {"const": "AMF_BUDGET_RECEIPT_2"},
        "problem_id": {"$ref": "#/$defs/problemId"},
        "target_card_sha256": {"$ref": "#/$defs/sha256"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context_tokens", "host_context_steers", "host_phase_prompts", "input_tokens_per_provider_request", "output_tokens_per_provider_request", "provider_request_attempts", "tool_calls", "verifier_calls", "wall_ms"],
          "properties": {
            "context_tokens": {"type": "integer", "minimum": 1},
            "host_context_steers": {"type": "integer", "minimum": 1},
            "host_phase_prompts": {"type": "integer", "minimum": 1},
            "input_tokens_per_provider_request": {"type": "integer", "minimum": 1},
            "output_tokens_per_provider_request": {"type": "integer", "minimum": 1},
            "provider_request_attempts": {"type": "integer", "minimum": 1},
            "tool_calls": {"type": "integer", "minimum": 1},
            "verifier_calls": {"type": "integer", "minimum": 1},
            "wall_ms": {"type": "integer", "minimum": 1}
          }
        },
        "maximum_artifact_bytes": {"type": "integer", "minimum": 1},
        "retain_failures": {"const": true},
        "stop_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "checked_at": {"type": "string", "format": "date"}
      }
    }
  }
}
