{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuan-chengzhi/agent-math-frontier/schemas/target-card.v1.schema.json",
  "title": "AMF frozen target card version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problem_id",
    "problem_card_sha256",
    "canonical_statement",
    "source_revision",
    "claim_scope",
    "success_criterion",
    "partial_progress_criterion",
    "stop_conditions",
    "candidate_schema",
    "verifier_id"
  ],
  "properties": {
    "schema": {"const": "AMF_TARGET_CARD_1"},
    "problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "problem_card_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_statement": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "claim_scope": {
      "enum": [
        "FULL_PROBLEM",
        "RECORD_IMPROVEMENT",
        "BOUNDED_COUNTEREXAMPLE",
        "FINITE_INSTANCE",
        "PARAMETER_RANGE",
        "SUBCLASS_RESULT",
        "FORMALIZATION_MILESTONE"
      ]
    },
    "success_criterion": {"type": "string", "minLength": 1},
    "partial_progress_criterion": {"type": "string", "minLength": 1},
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_schema": {"$ref": "#/$defs/fileBinding"},
    "verifier_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,110}\\.v[1-9][0-9]{0,15}$", "description": "Versioned verifier implementation selected for this frozen target."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
