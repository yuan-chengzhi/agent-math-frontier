{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuan-chengzhi/agent-math-frontier/schemas/problem-card.v1.schema.json",
  "title": "AMF problem card version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title_zh",
    "title_en",
    "domains",
    "track",
    "stage",
    "recommendation",
    "source",
    "statement",
    "formalization",
    "verification",
    "hard_gates",
    "fit",
    "risks_zh",
    "selection_note_zh"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "title_zh": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "track": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "stage": {"enum": ["raw", "curated", "active", "retired"]},
    "recommendation": {"enum": ["shortlist", "incubate", "watch", "quarantine"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_id", "canonical_url", "source_label", "checked_at", "status_confidence"],
      "properties": {
        "collection_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_label": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date"},
        "status_confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_zh", "target_zh", "success_artifact_zh", "partial_progress_zh"],
      "properties": {
        "summary_zh": {"type": "string", "minLength": 1},
        "target_zh": {"type": "string", "minLength": 1},
        "success_artifact_zh": {"type": "string", "minLength": 1},
        "partial_progress_zh": {"type": "string", "minLength": 1}
      }
    },
    "formalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "state", "system", "artifact_url", "revision", "declaration", "fidelity"],
      "properties": {
        "level": {"enum": ["proof_assistant", "executable_spec", "precise_informal", "research_program"]},
        "state": {"type": "string", "minLength": 1},
        "system": {"type": ["string", "null"]},
        "artifact_url": {"type": ["string", "null"]},
        "revision": {"type": "string", "minLength": 1},
        "declaration": {"type": ["string", "null"]},
        "fidelity": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"level": {"const": "proof_assistant"}}, "required": ["level"]},
          "then": {
            "properties": {
              "system": {"type": "string", "minLength": 1},
              "artifact_url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "declaration": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "system": {"type": "null"},
              "artifact_url": {"type": "null"},
              "declaration": {"type": "null"}
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "independent", "notes_zh"],
      "properties": {
        "mode": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$", "description": "Semantic verification capability required by the problem; not a verifier implementation ID."},
        "independent": {"const": true},
        "notes_zh": {"type": "string", "minLength": 1}
      }
    },
    "hard_gates": {"$ref": "#/$defs/hardGates"},
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiability",
        "feedback_richness",
        "representation",
        "decomposability",
        "tool_readiness",
        "partial_value",
        "math_value",
        "status_confidence",
        "resource_feasibility"
      ],
      "properties": {
        "verifiability": {"$ref": "#/$defs/score"},
        "feedback_richness": {"$ref": "#/$defs/score"},
        "representation": {"$ref": "#/$defs/score"},
        "decomposability": {"$ref": "#/$defs/score"},
        "tool_readiness": {"$ref": "#/$defs/score"},
        "partial_value": {"$ref": "#/$defs/score"},
        "math_value": {"$ref": "#/$defs/score"},
        "status_confidence": {"$ref": "#/$defs/score"},
        "resource_feasibility": {"$ref": "#/$defs/score"}
      }
    },
    "risks_zh": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "selection_note_zh": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "active"}}, "required": ["stage"]},
      "then": {
        "properties": {
          "hard_gates": {
            "type": "object",
            "properties": {
              "open_status": {"const": "pass"},
              "exact_target": {"const": "pass"},
              "verification_path": {"const": "pass"},
              "valuable_partial_progress": {"const": "pass"},
              "reproducibility": {"const": "pass"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "gate": {"enum": ["pass", "conditional", "fail", "unknown"]},
    "hardGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_status", "exact_target", "verification_path", "valuable_partial_progress", "reproducibility"],
      "properties": {
        "open_status": {"$ref": "#/$defs/gate"},
        "exact_target": {"$ref": "#/$defs/gate"},
        "verification_path": {"$ref": "#/$defs/gate"},
        "valuable_partial_progress": {"$ref": "#/$defs/gate"},
        "reproducibility": {"$ref": "#/$defs/gate"}
      }
    },
    "score": {"type": "integer", "minimum": 0, "maximum": 3}
  }
}
