{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuan-chengzhi/agent-math-frontier/schemas/target-bundle.v1.schema.json",
  "title": "AMF content-addressed target bundle version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problem_id",
    "problem_card_sha256",
    "target_card",
    "baseline_receipts",
    "review_receipts",
    "red_team_receipt",
    "budget_receipt"
  ],
  "properties": {
    "schema": {"const": "AMF_TARGET_BUNDLE_1"},
    "problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "problem_card_sha256": {"$ref": "#/$defs/sha256"},
    "target_card": {"$ref": "#/$defs/fileBinding"},
    "baseline_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileBinding"}
    },
    "review_receipts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/fileBinding"}
    },
    "red_team_receipt": {"$ref": "#/$defs/fileBinding"},
    "budget_receipt": {"$ref": "#/$defs/fileBinding"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
