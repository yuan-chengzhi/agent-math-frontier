{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuan-chengzhi/agent-math-frontier/schemas/verifier-registry.v1.schema.json",
  "title": "AMF verifier registry version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verifiers"],
  "properties": {
    "schema": {"const": "AMF_VERIFIER_REGISTRY_1"},
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verifier_id", "protocol", "manifest"],
        "properties": {
          "verifier_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,110}\\.v[1-9][0-9]{0,15}$"},
          "protocol": {"const": "AMF_VERIFIER_PROTOCOL_1"},
          "manifest": {"$ref": "#/$defs/fileBinding"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
