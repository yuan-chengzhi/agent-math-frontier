{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problem_id",
    "as_of",
    "status_statement",
    "baseline_facts",
    "known_route_baselines",
    "verification_caveats",
    "provenance_caveats"
  ],
  "properties": {
    "schema": {"const": "AMF_AGENT_BASELINE_BRIEF_1"},
    "problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "as_of": {"type": "string", "format": "date"},
    "status_statement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "baseline_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    },
    "known_route_baselines": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "result", "source", "research_consequence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "scope": {"type": "string", "minLength": 1, "maxLength": 2000},
          "result": {"type": "string", "minLength": 1, "maxLength": 4000},
          "source": {"type": "string", "format": "uri", "pattern": "^https://"},
          "research_consequence": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "verification_caveats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    },
    "provenance_caveats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    }
  }
}
