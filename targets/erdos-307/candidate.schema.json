{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuan-chengzhi/agent-math-frontier/targets/erdos-307/candidate.schema.json",
  "title": "Erdos 307 two finite prime sets candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "P", "Q", "prime_certificates"],
  "properties": {
    "schema": {"const": "AMF_ERDOS307_RECIPROCAL_PRIMES_1"},
    "P": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/positiveDecimal"}},
    "Q": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/positiveDecimal"}},
    "prime_certificates": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prime", "factors", "witness"],
        "properties": {
          "prime": {"$ref": "#/$defs/positiveDecimal"},
          "factors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [{"$ref": "#/$defs/positiveDecimal"}, {"type": "integer", "minimum": 1, "maximum": 4096}],
              "items": false
            }
          },
          "witness": {"$ref": "#/$defs/positiveDecimal"}
        }
      }
    }
  },
  "$defs": {
    "positiveDecimal": {"type": "string", "pattern": "^[1-9][0-9]{0,4095}$"}
  }
}
