{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuan-chengzhi/agent-math-frontier/targets/costas-order-32/candidate.schema.json",
  "title": "Costas array permutation of order 32",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "order", "permutation"],
  "properties": {
    "schema": {"const": "AMF_COSTAS32_PERMUTATION_1"},
    "order": {"const": 32},
    "permutation": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 32}
    }
  }
}
